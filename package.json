{
  "name": "qing-self",
  "version": "0.4.0",
  "description": "Scaffold for layered agent memory: memory files, judgment cards, full/compact model handoff, two-question ruler, compression review, portability diff, three-factor recall and schema check. Format-locked, zero-dependency, JSON-first.",
  "license": "MIT",
  "author": "malabananclauss-rgb",
  "homepage": "https://github.com/malabananclauss-rgb/qing-self#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malabananclauss-rgb/qing-self.git"
  },
  "bugs": {
    "url": "https://github.com/malabananclauss-rgb/qing-self/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./lib/core.js",
    "./format": "./lib/format.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-self": "./bin/dsh-self.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "bin",
    "templates",
    "locale",
    "assets",
    "screenshots.json",
    "icon.svg",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "selftest": "node test/selftest.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "judgment",
    "handoff",
    "scaffold",
    "agent-memory"
  ]
}